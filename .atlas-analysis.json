  "keyFeatures": [
    "MDX-based page authoring with rich components",
    "Customizable branding and themes",
    "Flexible navigation and sidebar configuration",
    "Built-in API reference support",
    "One-click publishing and deployment",
    "AI-assisted writing tools",
    "Contextual help integrations (ChatGPT, Claude, Perplexity)"
  ],
  "publicApiSurface": [
    "docs.json configuration schema",
    "MDX frontmatter fields (title, description, sidebarTitle, icon)",
    "Navigation object (tabs, groups, pages, anchors)",
    "Mintlify CLI: mint dev, mint validate, mint broken-links",
    "Component library: Card, Tip, Steps, Step, CodeBlock, Callout",
    "REST API: pages, deployments"
